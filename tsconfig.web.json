{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "public",
    "rootDir": ".",
    "lib": ["ES2020", "DOM"]
  },
  "include": ["web/**/*.ts", "src/shared/**/*.ts"]
}
